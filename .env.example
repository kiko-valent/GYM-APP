# Copia este fichero a .env (está en .gitignore) y rellena los valores reales.
# VITE_* configura el proyecto Supabase de la app web y los scripts de tools/.
# En Vercel, añadir únicamente VITE_* como variables de entorno del proyecto.
# SEED_* es exclusivo de los scripts locales; no subir credenciales al repositorio.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Cuenta con la que se autentica el script de siembra del plan
SEED_USER_EMAIL=tu-email@example.com
SEED_USER_PASSWORD=tu-password
SEED_USER_ID=uuid-del-usuario
